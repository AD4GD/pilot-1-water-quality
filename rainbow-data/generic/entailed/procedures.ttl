    rdfs:seeAlso <https://www.jbl.de/?mod=products&func=detail&id=8673&country=gb&lang=en#2412517> ;
    skos:definition "A simple Nitrate measurement based on color reaction. No further equipment needed. The semi-quantitative result is a classification of Nitrate concentration in one the 9 classes (values in mg/L): \"<0,5\", \"1\", \"3\", \"5\", \"15\", \"30\", \"60\", \"120\", \"200\"" ;
    skos:inScheme <https://w3id.org/ad4gd/water-quality/procedures> ;
    skos:prefLabel "JBL Pro Aquatest NO3 Water Analysis" ;
    skos:topConceptOf <https://w3id.org/ad4gd/water-quality/procedures> .

<https://w3id.org/ad4gd/water-quality/procedures/Tetra_Test_GH> a skos:Concept,
        sosa:Procedure ;
    dcterms:source [ skos:prefLabel "Tetra GmbH" ;
            foaf:homepage <https://www.tetra.net/en-gb> ] ;
    ns1:status <http://www.opengis.net/def/status/valid> ;
    rdfs:seeAlso <https://www.tetra.net/de-de/produkte/tetra-test-6in1> ;
    skos:definition "A fast and easy testing of water quality based on colour reaction on the test strip. No further equipment needed. The semi-quantitative result is a classification of total hardness in one the 4 classes (values in °d): \"0\", \"4\", \"8\", \"10\"" ;
    skos:inScheme <https://w3id.org/ad4gd/water-quality/procedures> ;
    skos:prefLabel "Tetra Test 6 in 1 Test strips" ;
    skos:topConceptOf <https://w3id.org/ad4gd/water-quality/procedures> .

