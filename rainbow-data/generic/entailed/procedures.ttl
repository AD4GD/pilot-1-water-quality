<https://w3id.org/ad4gd/water-quality/procedures/> a skos:Collection ;
    dcterms:provenance "Generated by the OGC Definitions Server to support integration of the elements of this ConceptScheme into bigger collections. ogc_skos_profile_entailements.ttl" ;
    skos:definition "Collection hierarchy for this ConceptScheme" ;
    skos:inScheme <https://w3id.org/ad4gd/water-quality/procedures> ;
    skos:prefLabel "Concepts in AD4GD water quality observation procedures" .

<https://w3id.org/ad4gd/water-quality/procedures/Easy_Life_PO4> a skos:Concept,
        sosa:Procedure ;
    dcterms:source [ skos:prefLabel "Easy Life International B.V." ;
            foaf:homepage <https://www.easylife.eu/> ] ;
    ns1:status <http://www.opengis.net/def/status/valid> ;
    rdfs:seeAlso <https://www.easylife.eu/products/freshwater/water-tests/phosphate> ;
    skos:definition "A simple Ortho-phosphate measurement based on colour reactions. No further equipment needed. The semi-quantitative result is a classification of ortho-phosphate concentration in one of 9 classes (values in mg/L): \"0\", \"0.02\", \"0.05\", \"0.1\", \"0.2\", \"0.5\", \"1\", \"1.5\", \"2\"" ;
    skos:inScheme <https://w3id.org/ad4gd/water-quality/procedures> ;
    skos:prefLabel "Easy Life PO4 Phosphate Test Kit Water Quality Tests" ;
    skos:topConceptOf <https://w3id.org/ad4gd/water-quality/procedures> .

<https://w3id.org/ad4gd/water-quality/procedures/ISO_6878-2004> a skos:Concept,
        sosa:Procedure ;
    dcterms:source [ skos:prefLabel "AD4GD" ;
            foaf:homepage <https://ad4gd.eu/> ] ;
    ns1:status <http://www.opengis.net/def/status/valid> ;
    rdfs:seeAlso <https://www.iso.org/standard/36917.html> ;
    owl:sameAs <https://dx.doi.org/10.31030/9552789> ;
    skos:definition "ISO 6878:2004 specifies methods for the determination of orthophosphate, orthophosphate after solvent extraction, hydrolysable phosphate plus orthophosphate, and total phosphorus after decomposition.The methods are applicable to all kinds of water including seawater and effluents. Phosphorus concentrations within the range of 0,005 mg/l to 0,8 mg/l may be determined in such samples without dilution. A solvent extraction procedure allows smaller phosphorus concentrations to be determined with a detection limit of about 0,000 5 mg/l." ;
    skos:inScheme <https://w3id.org/ad4gd/water-quality/procedures> ;
    skos:prefLabel "International standard ISO 6878:2004, Published (Edition 2, 2004)" ;
    skos:topConceptOf <https://w3id.org/ad4gd/water-quality/procedures> .

